---
---

<section id="music" class="py-32 px-6 bg-surface-800/50">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-brand-500 text-sm font-semibold uppercase tracking-[0.2em] mb-4">Listen</p>
      <h2 class="text-4xl sm:text-5xl font-bold tracking-tight">
        Music<span class="text-brand-500">.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Track cards — replace these with your actual tracks/embeds -->
      <div class="group bg-surface-700/50 border border-white/5 rounded-2xl overflow-hidden hover:border-brand-500/20 transition-all duration-300 hover:-translate-y-1">
        <div class="aspect-square bg-surface-600 relative overflow-hidden">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-16 h-16 rounded-full bg-brand-500/10 flex items-center justify-center group-hover:bg-brand-500/20 transition-colors">
              <svg class="w-8 h-8 text-brand-500 ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-surface-500">
            <div class="h-full w-1/3 bg-brand-500"></div>
          </div>
        </div>
        <div class="p-6">
          <h3 class="font-semibold text-lg mb-1">Track Title</h3>
          <p class="text-neutral-500 text-sm">Single &bull; 2026</p>
        </div>
      </div>

      <div class="group bg-surface-700/50 border border-white/5 rounded-2xl overflow-hidden hover:border-brand-500/20 transition-all duration-300 hover:-translate-y-1">
        <div class="aspect-square bg-surface-600 relative overflow-hidden">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-16 h-16 rounded-full bg-brand-500/10 flex items-center justify-center group-hover:bg-brand-500/20 transition-colors">
              <svg class="w-8 h-8 text-brand-500 ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-surface-500">
            <div class="h-full w-2/3 bg-brand-500"></div>
          </div>
        </div>
        <div class="p-6">
          <h3 class="font-semibold text-lg mb-1">Track Title</h3>
          <p class="text-neutral-500 text-sm">Collaboration &bull; 2025</p>
        </div>
      </div>

      <div class="group bg-surface-700/50 border border-white/5 rounded-2xl overflow-hidden hover:border-brand-500/20 transition-all duration-300 hover:-translate-y-1">
        <div class="aspect-square bg-surface-600 relative overflow-hidden">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-16 h-16 rounded-full bg-brand-500/10 flex items-center justify-center group-hover:bg-brand-500/20 transition-colors">
              <svg class="w-8 h-8 text-brand-500 ml-1" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-surface-500">
            <div class="h-full w-1/2 bg-brand-500"></div>
          </div>
        </div>
        <div class="p-6">
          <h3 class="font-semibold text-lg mb-1">Track Title</h3>
          <p class="text-neutral-500 text-sm">Session &bull; 2025</p>
        </div>
      </div>
    </div>

    <!-- Spotify / SoundCloud embed placeholder -->
    <div class="mt-16 bg-surface-700/50 border border-white/5 rounded-2xl p-8 text-center">
      <p class="text-neutral-500 mb-4">Embed your Spotify or SoundCloud player here</p>
      <div class="max-w-2xl mx-auto bg-surface-600 rounded-xl h-20 flex items-center justify-center text-neutral-600 text-sm">
        <!-- Replace with: <iframe src="https://open.spotify.com/embed/artist/YOUR_ID" ...></iframe> -->
        Spotify / SoundCloud Embed
      </div>
    </div>
  </div>
</section>
