<section id="about" class="py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <div class="relative group">
        <div class="aspect-[3/4] bg-surface-700 rounded-2xl overflow-hidden relative">
          <!-- Replace this div with your photo: <img src="/your-photo.jpg" alt="Alex Mifsud" class="w-full h-full object-cover" /> -->
          <div class="absolute inset-0 flex items-center justify-center text-neutral-500">
            <div class="text-center">
              <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm">Add your photo here</p>
            </div>
          </div>
        </div>
        <div class="absolute -bottom-4 -right-4 w-full h-full border-2 border-brand-500/20 rounded-2xl -z-10 group-hover:border-brand-500/40 transition-colors duration-500"></div>
      </div>

      <div>
        <p class="text-brand-500 text-sm font-semibold uppercase tracking-[0.2em] mb-4">About Me</p>
        <h2 class="text-4xl sm:text-5xl font-bold tracking-tight mb-8">
          The Low End<span class="text-brand-500">.</span>
        </h2>
        <div class="space-y-6 text-neutral-400 leading-relaxed text-lg">
          <p>
            I'm Alex Mifsud, a bass player driven by groove, tone, and feel.
            Whether it's a deep pocket funk line or a melodic progression,
            I bring a solid foundation to every project I'm part of.
          </p>
          <p>
            With experience across genres — from jazz and funk to rock, pop,
            and everything in between — I've had the privilege of performing
            live, recording in the studio, and collaborating with talented
            artists and producers.
          </p>
          <p>
            I'm always looking for the next creative challenge. If you need
            a bassist who listens, grooves, and delivers — let's talk.
          </p>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-6">
          <div class="text-center p-4 bg-surface-800 rounded-xl border border-white/5">
            <p class="text-3xl font-bold text-brand-500">10+</p>
            <p class="text-sm text-neutral-500 mt-1">Years Playing</p>
          </div>
          <div class="text-center p-4 bg-surface-800 rounded-xl border border-white/5">
            <p class="text-3xl font-bold text-brand-500">50+</p>
            <p class="text-sm text-neutral-500 mt-1">Live Shows</p>
          </div>
          <div class="text-center p-4 bg-surface-800 rounded-xl border border-white/5">
            <p class="text-3xl font-bold text-brand-500">20+</p>
            <p class="text-sm text-neutral-500 mt-1">Collaborations</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
