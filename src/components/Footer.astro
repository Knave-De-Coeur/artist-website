---

<footer class="py-16 px-6 border-t border-white/5">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="text-center md:text-left">
        <a href="#" class="text-2xl font-bold tracking-tight text-white">
          ALEX<span class="text-brand-500">.</span>
        </a>
        <p class="text-neutral-500 text-sm mt-2">Bass Player &bull; Session Musician &bull; Artist</p>
      </div>

      <div class="flex items-center gap-4">
        {socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.name}
            class="w-10 h-10 rounded-full bg-surface-700 border border-white/5 flex items-center justify-center hover:bg-brand-500 hover:border-brand-500 group transition-all duration-200"
          >
            <svg class="w-4 h-4 text-neutral-400 group-hover:text-surface-900 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d={social.icon} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-10 pt-8 border-t border-white/5 text-center">
      <p class="text-neutral-600 text-sm">
        &copy; {currentYear} Alex Mifsud. All rights reserved.
      </p>
    </div>
  </div>
</footer>
