---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-surface-900 via-surface-800 to-surface-900"></div>

  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-brand-500/20 rounded-full blur-[128px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 bg-brand-700/15 rounded-full blur-[100px]"></div>
  </div>

  <div class="absolute inset-0 opacity-[0.03]"
    style="background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 viewBox=%220 0 60 60%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cg fill=%22none%22 fill-rule=%22evenodd%22%3E%3Cg fill=%22%23ffffff%22 fill-opacity=%221%22%3E%3Cpath d=%22M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');">
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl">
    <div class="animate-fade-in-up">
      <p class="text-brand-500 text-sm font-semibold uppercase tracking-[0.3em] mb-6">
        Bass Player &bull; Session Musician &bull; Artist
      </p>
    </div>

    <h1 class="animate-fade-in-up delay-100 text-6xl sm:text-7xl md:text-8xl lg:text-9xl font-black tracking-tighter leading-none mb-8">
      ALEX
      <span class="block text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-brand-500 to-brand-600">
        MIFSUD
      </span>
    </h1>

    <p class="animate-fade-in-up delay-200 text-lg sm:text-xl text-neutral-400 max-w-2xl mx-auto mb-12 leading-relaxed">
      Laying down the groove, one line at a time. Available for sessions,
      live performances, and creative collaborations.
    </p>

    <div class="animate-fade-in-up delay-300 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#music"
        class="px-8 py-4 bg-brand-500 hover:bg-brand-400 text-surface-900 font-bold text-sm uppercase tracking-widest rounded-lg transition-all duration-200 hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5"
      >
        Listen Now
      </a>
      <a
        href="#contact"
        class="px-8 py-4 border border-white/15 hover:border-brand-500/50 text-white font-bold text-sm uppercase tracking-widest rounded-lg transition-all duration-200 hover:-translate-y-0.5"
      >
        Get in Touch
      </a>
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
